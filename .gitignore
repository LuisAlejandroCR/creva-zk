node_modules/
dist/
build/
.turbo/

# Carpeta de herramienta: worktrees de agentes, fotogramas de referencia y
# cualquier scratch. Nada de aquí pertenece al repositorio entregado.
# Ver docs/agentes-paralelos.md del expediente.
.claude/

# Compact — artefactos generados por el compilador
contract/src/managed/
**/*.zkir
**/*.bzkir
keys/
# Copia servida al navegador — la escribe web/scripts/copy-zk-artifacts.mjs
web/public/zk/

# Entorno y secretos — nunca, bajo ningún nombre
.env
.env.*
!.env.example
*.key
*.pem
wallet.json
seed*

# Grabaciones — el mp4 de la demo pesa ~95 MB y no pertenece al repositorio.
# docs/pitch/index.html lo referencia por ruta relativa; se sube a YouTube o
# a Devpost, no a git.
*.mp4
*.mov
*.webm

# Logs y estado local
logs/
*.log
.private-state/
# LevelDB del private state provider, creada al correr la demo
midnight-level-db/
.states/

# Sistema
.DS_Store
Thumbs.db
