{
  // contract/tsconfig.json
  // Typechecks the witnesses and anything hand-written under src/. The
  // generated managed/ output is produced by `npm run compact`, which is why
  // verify compiles the circuit before it ever reaches tsc.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
