{
  // contract/tsconfig.json
  // Typechecks the witnesses and tests hand-written under src/ and test/.
  // The generated managed/ output is produced by `npm run compact`, which is
  // why verify compiles the circuit before it ever reaches tsc.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
