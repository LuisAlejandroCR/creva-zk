// schnorr.compact
// Schnorr signature verification over the JubJub curve, adapted from
// midnightntwrk/example-zkloan (Apache-2.0), contract/src/schnorr.compact
// (commit 25b22e3). Compact 0.31.1's
// standard library has no signature verification primitive yet — this
// builds one from ecAdd/ecMul/ecMulGenerator plus a witness-assisted
// 248-bit challenge reduction. It is a polyfill: once the compiler ships
// jubjubSchnorrVerify, this file goes away and Attestation.compact calls
// that instead.
//
// Changed from the upstream file: the challenge is no longer inlined in
// schnorrVerify but factored into the exported pure circuit below, and
// that circuit is generic over the message length rather than fixed at
// Vector<4> — at Vector<4> it hashed a different struct than
// schnorrVerify<1> does, so its output was a challenge no verifier would
// ever compute.
//
// schnorrChallenge is exported so an off-chain signer can obtain the very
// challenge this circuit will check, by calling the compiled contract's
// own pureCircuits binding rather than by reimplementing transientHash in
// TypeScript. schnorrVerify computes its challenge by calling it too, so
// there is exactly one definition of the challenge in the system.

module schnorr {
  import CompactStandardLibrary;

  export struct SchnorrSignature {
    announcement: JubjubPoint;
    response: Field;
  }

  struct SchnorrHashInput<#n> {
    ann_x: Field;
    ann_y: Field;
    pk_x: Field;
    pk_y: Field;
    msg: Vector<n, Field>;
  }

  // The witness provides the quotient and remainder of dividing the challenge hash
  // by 2^248, so we can truncate it to fit in Jubjub's scalar field.
  // The quotient is Uint<7> (not Field) so the reduction below is checked over the
  // integers rather than modulo the field prime — see the range assert in schnorrVerify.
  witness getSchnorrReduction(challengeHash: Field): [Uint<7>, Uint<248>];

  export circuit schnorrVerify<#n>(
                   msg: Vector<n, Field>,
                   signature: SchnorrSignature,
                   pk: JubjubPoint
                   ): [] {
    const {announcement, response} = signature;
    // The one and only place the challenge is defined — the same circuit
    // the off-chain signer calls through pureCircuits.
    const cFull: Field =
            schnorrChallenge<n>(jubjubPointX(announcement),
                                jubjubPointY(announcement),
                                jubjubPointX(pk),
                                jubjubPointY(pk),
                                msg);
    // Truncate challenge to 248 bits via witness-assisted division by 2^248.
    // The witness provides (quotient, remainder) such that cFull == q * 2^248 + r
    // where r : Uint<248>, guaranteeing r < 2^248 < Jubjub subgroup order.
    // This is needed because ecMul requires scalars < JUBJUB_ORDER (~2^252.4),
    // but transientHash returns values in BLS12-381's scalar field (~2^255).
    const TWO_248: Field =
            452312848583266388373324160190187140051835877600158453279131187530910662656 as Field;
    const [q, cTruncated] = getSchnorrReduction(cFull);
    // Bound the quotient so the reduction equation holds over the integers, not
    // modulo the field prime. Without this, q : Field is unconstrained and a prover
    // could pick any cTruncated (i.e. any challenge) and solve for a matching q,
    // forging the signature. floor((BLS12-381 scalar prime - 1) / 2^248) == 115,
    // so an honest quotient is always in [0, 115].
    assert(disclose(q) < 116, "Schnorr quotient out of range");
    assert(disclose(q) * TWO_248 + (disclose(cTruncated) as Field) == cFull,
           "Invalid challenge reduction"
           );
    const c: Field = disclose(cTruncated) as Field;
    const lhs: JubjubPoint = ecMulGenerator(response);
    const rhs: JubjubPoint = ecAdd(announcement, ecMul(pk, c));
    assert(jubjubPointX(lhs) == jubjubPointX(rhs) && jubjubPointY(lhs) == jubjubPointY(rhs),
           "Invalid attestation signature");
  }

  // Generic over the message length, exactly as schnorrVerify is: a
  // concrete instantiation compiled at the wrong n would hash a different
  // struct and produce a challenge the verifier never computes. The
  // previous Vector<4> version had precisely that bug — verifyAttestation
  // calls schnorrVerify<1>.
  //
  // Returns the FULL hash. Callers must truncate to 248 bits (mod 2^248)
  // to match schnorrVerify's challenge reduction above.
  export pure circuit schnorrChallenge<#n>(
                        ann_x: Field,
                        ann_y: Field,
                        pk_x: Field,
                        pk_y: Field,
                        msg: Vector<n, Field>
                        ): Field {
    return transientHash<SchnorrHashInput<n>>(
             SchnorrHashInput<n> { ann_x: ann_x, ann_y: ann_y, pk_x: pk_x, pk_y: pk_y, msg: msg }
             );
  }
}
