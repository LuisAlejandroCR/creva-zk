// Attestation.compact
// Creva ZK primitive, written once: one struct shape and one verification
// circuit, imported by every predicate. An issuer signs a claim about a
// subject off-device; the subject supplies the whole package as a
// witness; the circuit recomputes the signed message and checks it
// against the issuer's known key before the claim is trusted for
// anything. The claim's shape (`T`) is chosen by each predicate — this
// module never looks inside it.
//
// The two hashing steps verifyAttestation performs are exported as pure
// circuits (attestationMessage, attestationChallenge) so an off-chain
// issuer can compute the challenge by CALLING this contract rather than
// by reimplementing Compact's transientHash in TypeScript. Signer and
// verifier then agree by construction.
//
// A module file (as opposed to a top-level program) carries no `pragma`
// and imports from inside its own `module { ... }` block — confirmed
// against the compiler, not assumed.

module Attestation {
  import CompactStandardLibrary;
  import schnorr;

  // Everything the issuer actually signs: whose attestation this is, and
  // what is being attested. Kept separate from the signature itself so
  // `verifyAttestation` can hash exactly this and nothing else.
  export struct SignedPayload<T> {
    subjectKey: JubjubPoint;
    claim: T;
  }

  // subjectKey ties the attestation to whoever is proving with it, so an
  // attestation issued for one person cannot be replayed by another.
  // claim carries the predicate-specific private facts. signature is the
  // issuer's Schnorr signature over the payload above.
  export struct Attestation<T> {
    payload: SignedPayload<T>;
    signature: SchnorrSignature;
  }

  // Recomputes the signed message from the attestation's own fields —
  // never from anything the caller asserts separately — and checks it
  // against the issuer's known verifying key. This is the only place a
  // signature is ever checked: inside the circuit, before the claim is
  // used for anything else. schnorrVerify asserts internally, so a call
  // that returns at all means the signature held.
  export circuit verifyAttestation<T>(att: Attestation<T>, issuerKey: JubjubPoint): [] {
    schnorrVerify<1>(attestationMessage<T>(att.payload), att.signature, issuerKey);
  }

  // The message schnorrVerify signs over, as its own pure circuit: the
  // single-element Vector whose one Field is the hash of the payload.
  // verifyAttestation calls it, and so does an off-chain signer — through
  // the compiled contract's pureCircuits binding — so neither side ever
  // holds a private copy of this encoding.
  export pure circuit attestationMessage<T>(payload: SignedPayload<T>): Vector<1, Field> {
    return [transientHash<SignedPayload<T>>(payload)];
  }

  // Everything the signer needs in one call: the payload hash and the
  // Schnorr challenge over it, composed exactly as verifyAttestation
  // composes them. The result is the FULL challenge — a signer must
  // truncate it to 248 bits (mod 2^248) to match schnorrVerify's
  // witness-assisted reduction.
  //
  // Generic in T, so each predicate exports its own concrete
  // instantiation (see identity-check.compact and backing-tier.compact);
  // only a concrete instantiation gets a TypeScript binding.
  export pure circuit attestationChallenge<T>(
                        payload: SignedPayload<T>,
                        announcement: JubjubPoint,
                        issuerKey: JubjubPoint
                        ): Field {
    return schnorrChallenge<1>(jubjubPointX(announcement),
                               jubjubPointY(announcement),
                               jubjubPointX(issuerKey),
                               jubjubPointY(issuerKey),
                               attestationMessage<T>(payload));
  }
}
